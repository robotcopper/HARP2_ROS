<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_teach_replay</name>
  <version>0.0.1</version>
  <description>Teach &amp; replay gamepad-driven trajectories with a nav2 collision_monitor safety overlay (auto-pause on obstacle).</description>
  <maintainer email="floris.jousselin@neura-robotics.com">floris</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rosbag2_interfaces</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_bringup</exec_depend>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>robot_controller</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
